<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Day Orchestrator keep-alive agent (ADR-006 ops wrapper).
     Install:
       cp ops/launchd/com.agp.day-orchestrator.plist ~/Library/LaunchAgents/
       # generate with `uv run python -m app.cli install` (paths are filled in automatically)
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.agp.day-orchestrator.plist
     Logs: ~/Library/Application Support/day-orchestrator/logs/
-->
<dict>
    <key>Label</key>
    <string>com.agp.day-orchestrator</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/agp/Desktop/google-adk/day-orchestrator/DayOrchestrator.app/Contents/MacOS/DayOrchestrator</string>
        <string>serve</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Users/agp/Library/Application Support/day-orchestrator/logs/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/agp/Library/Application Support/day-orchestrator/logs/stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONDONTWRITEBYTECODE</key>
        <string>1</string>
    </dict>
</dict>
</plist>
