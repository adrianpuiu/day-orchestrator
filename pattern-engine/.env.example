MODEL_API_BASE=
MODEL_API_KEY=

# Hyperliquid shadow mode (read-only): account address only, NEVER a key.
HL_ACCOUNT_ADDRESS=

# Order-capable path (Step 2.2). API wallet secret from HL Settings -> API.
# Read once at first send; never in session state, never logged.
HL_API_SECRET=

# The API wallet's own address (shown at creation) — preflight verifies the
# secret derives exactly this address before anything is armed.
HL_API_WALLET=
